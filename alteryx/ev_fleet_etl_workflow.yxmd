      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="414" y="66" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="IF ISNULL([Temperature]) THEN 22.5 ELSE [Temperature] ENDIF" field="Temperature" size="8" type="Double" />
            <FormulaField expression="IF ISNULL([Distance_Travelled]) THEN [Energy_Consumed] * 3.8 ELSE [Distance_Travelled] ENDIF" field="Distance_Travelled" size="8" type="Double" />
            <FormulaField expression="([Energy_Consumed] / [Distance_Travelled]) * 100" field="Efficiency_kWh_100km" size="8" type="Double" />
            <FormulaField expression="IF [Battery_State_of_Health] &gt;= 90 THEN 'Healthy' ELSEIF [Battery_State_of_Health] &gt;= 80 THEN 'Moderate' ELSE 'Critical' ENDIF" field="Degradation_Status" size="20" type="V_String" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Formula (Missing Value Imputation &amp; Calculations)</Name>
          <DefaultAnnotationText>Temperature = IF ISNULL([Temperature]) THEN 22.5 ELSE [Temperature] ENDIF
